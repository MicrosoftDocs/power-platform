{
  "swagger": "2.0",
  "info": {
    "title": "Microsoft Power Platform REST API - dynamics",
    "description": "Unified API for all administrative capabilities in Microsoft Power Platform.",
    "version": "2024-10-01"
  },
  "host": "api.powerplatform.com",
  "schemes": [
    "https"
  ],
  "paths": {
    "/dynamics/environments/{environmentId}/finopsadminsettings": {
      "get": {
        "tags": [
          "FinanceAndOperationsMaintenanceSettings"
        ],
        "summary": "Get Finance and Operations Maintenance Settings.",
        "description": "Retrieves the F&O maintenance settings for an environment managed by Power Platform admin center.",
        "operationId": "GetFinOpsMaintenanceSettings",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "environmentId",
            "description": "The unique identifier of the environment.",
            "required": true,
            "type": "string",
            "format": "uuid"
          },
          {
            "in": "query",
            "name": "api-version",
            "description": "The API version.",
            "required": true,
            "type": "string",
            "default": "2024-10-01"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved Finance and Operations Maintenance.",
            "schema": {
              "$ref": "#/definitions/FinOpsAdminSettingsResponse"
            }
          },
          "400": {
            "description": "Bad Request.",
            "schema": {
              "$ref": "#/definitions/FinOpsErrorResponse"
            }
          },
          "401": {
            "description": "Unauthorized.",
            "schema": {
              "$ref": "#/definitions/FinOpsErrorResponse"
            }
          },
          "403": {
            "description": "Forbidden.",
            "schema": {
              "$ref": "#/definitions/FinOpsErrorResponse"
            }
          },
          "404": {
            "description": "Not Found.",
            "schema": {
              "$ref": "#/definitions/FinOpsErrorResponse"
            }
          },
          "500": {
            "description": "Internal Server Error.",
            "schema": {
              "$ref": "#/definitions/FinOpsErrorResponse"
            }
          }
        }
      },
      "put": {
        "tags": [
          "FinanceAndOperationsMaintenanceSettings"
        ],
        "summary": "Update Finance and Operations Maintenance Settings.",
        "description": "Updates the F&O maintenance settings for an environment managed by Power Platform admin center.",
        "operationId": "UpdateFinOpsMaintenanceSettings",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "environmentId",
            "description": "The unique identifier of the environment.",
            "required": true,
            "type": "string",
            "format": "uuid"
          },
          {
            "in": "query",
            "name": "api-version",
            "description": "The API version.",
            "required": true,
            "type": "string",
            "default": "2024-10-01"
          },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/UpdateFinOpsAdminSettingsRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully updated Finance and Operations Maintenance.",
            "schema": {
              "$ref": "#/definitions/FinOpsAdminSettingsResponse"
            }
          },
          "400": {
            "description": "Bad Request.",
            "schema": {
              "$ref": "#/definitions/FinOpsErrorResponse"
            }
          },
          "401": {
            "description": "Unauthorized.",
            "schema": {
              "$ref": "#/definitions/FinOpsErrorResponse"
            }
          },
          "403": {
            "description": "Forbidden.",
            "schema": {
              "$ref": "#/definitions/FinOpsErrorResponse"
            }
          },
          "404": {
            "description": "Not Found.",
            "schema": {
              "$ref": "#/definitions/FinOpsErrorResponse"
            }
          },
          "500": {
            "description": "Internal Server Error.",
            "schema": {
              "$ref": "#/definitions/FinOpsErrorResponse"
            }
          }
        }
      }
    },
    "/dynamics/environments/{environmentId}/finopsproperties": {
      "get": {
        "tags": [
