            }
          },
          "404": {
            "description": "Not Found.",
            "schema": {
              "$ref": "#/definitions/FinOpsErrorResponse"
            }
          },
          "500": {
            "description": "Internal Server Error.",
            "schema": {
              "$ref": "#/definitions/FinOpsErrorResponse"
            }
          }
        }
      }
    },
    "/dynamics/environments/{environmentId}/finopsversions": {
      "get": {
        "tags": [
          "FinanceAndOperationsVersions"
        ],
        "summary": "Get available Finance and Operations versions.",
        "description": "Retrieves the list of Finance and Operations application versions available for an environment.",
        "operationId": "GetFinOpsVersions",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "environmentId",
            "description": "The unique identifier of the environment.",
            "required": true,
            "type": "string",
            "format": "uuid"
          },
          {
            "in": "query",
            "name": "api-version",
            "description": "The API version.",
            "required": true,
            "type": "string",
            "default": "2024-10-01"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved available Finance and Operations versions.",
            "schema": {
              "$ref": "#/definitions/FinOpsVersionsResponse"
            }
          },
          "400": {
            "description": "Bad Request.",
            "schema": {
              "$ref": "#/definitions/FinOpsErrorResponse"
            }
          },
          "401": {
            "description": "Unauthorized.",
            "schema": {
              "$ref": "#/definitions/FinOpsErrorResponse"
            }
          },
          "403": {
            "description": "Forbidden.",
